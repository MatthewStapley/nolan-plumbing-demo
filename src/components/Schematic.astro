---
// Placeholder hero artwork: a line drawing of a pipe run. Replaced
// automatically once heroImage is set in src/data/site.ts.
const runs = [
  "M -20 150 H 250 Q 300 150 300 200 V 420 Q 300 470 350 470 H 620",
  "M 300 300 H 440 Q 490 300 490 350 V 780",
  "M 120 150 V 780",
];
---

<svg class="schematic" viewBox="0 0 600 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="#ffffff" opacity="0.09"></circle>
    </pattern>
  </defs>
  <rect width="600" height="760" fill="url(#grid)"></rect>

  {runs.map((d) => <path d={d} class="pipe-outer" />)}
  {runs.map((d) => <path d={d} class="pipe-inner" />)}
  <path class="flow" pathLength="1" d="M -20 150 H 250 Q 300 150 300 200 V 420 Q 300 470 350 470 H 620"></path>

  <!-- couplings -->
  <g class="fitting">
    <rect x="200" y="130" width="14" height="40"></rect>
    <rect x="280" y="240" width="40" height="14"></rect>
    <rect x="280" y="370" width="40" height="14"></rect>
    <rect x="400" y="450" width="14" height="40"></rect>
    <rect x="380" y="280" width="14" height="40"></rect>
    <rect x="470" y="420" width="40" height="14"></rect>
    <rect x="100" y="300" width="40" height="14"></rect>
    <rect x="100" y="560" width="40" height="14"></rect>
  </g>

  <!-- valve -->
  <g class="valve" transform="translate(120 150)">
    <rect x="-26" y="-26" width="52" height="52" rx="4"></rect>
    <line x1="0" y1="-26" x2="0" y2="-62"></line>
    <rect x="-34" y="-72" width="68" height="12" rx="6" class="valve-handle"></rect>
  </g>

  <!-- tee marker -->
  <circle cx="300" cy="300" r="7" class="node"></circle>
</svg>
